{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "vitest*.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts"
  ]
}
