DATABASE_URL=postgresql://deploygrid:deploygrid@127.0.0.1:5432/deploygrid
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_URL=http://127.0.0.1:4000
BUILD_TIMEOUT_MS=600000
HEALTH_TIMEOUT_MS=60000
WORKER_CONCURRENCY=1
CONTAINER_MEMORY=512m
CONTAINER_CPUS=1
CONTAINER_PIDS=128

# Run pnpm setup:key once to fill this with a securely generated key. Keep it backed up.
DEPLOYGRID_ENCRYPTION_KEY=
GATEWAY_PORT=8080
HEALTH_INTERVAL_MS=10000
HEALTH_FAILURE_THRESHOLD=3
# Optional: installed cloudflared executable, e.g. C:\Tools\cloudflared.exe
# CLOUDFLARED_PATH=cloudflared
