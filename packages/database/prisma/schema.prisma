generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
}
enum DeploymentStatus {
  QUEUED
  CLONING
  BUILDING
  STARTING
  VERIFYING
  SUCCEEDED
  FAILED
}
enum RuntimeStatus {
  NOT_DEPLOYED
  RUNNING
  STOPPED
  DEGRADED
  UNKNOWN
}
model Project {
  id String @id @default(cuid())
  name String
  slug String @unique
  repositoryUrl String
  serviceType String @default("WEB")
  sourceType String @default("GIT")
  runtime String @default("DOCKER")
  imageUrl String @default("")
  rootDirectory String @default("")
  dockerfilePath String @default("Dockerfile")
  buildCommand String @default("")
  startCommand String @default("")
  publishDirectory String @default("dist")
  spaFallback Boolean @default(false)
  branch String @default("")
  containerPort Int @default(3000)
  healthPath String @default("/")
  runtimeStatus RuntimeStatus @default(NOT_DEPLOYED)
  currentDeploymentId String? @unique
  currentDeployment Deployment? @relation("Current", fields: [currentDeploymentId], references: [id], onDelete: SetNull)
  activeDeploymentId String? @unique
  activeDeployment Deployment? @relation("Active", fields: [activeDeploymentId], references: [id], onDelete: SetNull)
  operationToken String?
  deployments Deployment[] @relation("History")
  variables ProjectVariable[]
  healthChecks HealthCheck[]
  desiredRunning Boolean @default(true)
  healthFailures Int @default(0)
  lastCheckedAt DateTime?
  healthMessage String?
  shareEnabled Boolean @default(false)
  publicUrl String?
  sharingStatus String @default("DISABLED")
  sharingError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Deployment {
  id String @id @default(cuid())
  projectId String
  project Project @relation("History", fields: [projectId], references: [id], onDelete: Cascade)
  currentFor Project? @relation("Current")
  activeFor Project? @relation("Active")
  repositoryUrl String
  serviceType String @default("WEB")
  sourceType String @default("GIT")
  runtime String @default("DOCKER")
  imageUrl String @default("")
  rootDirectory String @default("")
  dockerfilePath String @default("Dockerfile")
  buildCommand String @default("")
  startCommand String @default("")
  publishDirectory String @default("dist")
  spaFallback Boolean @default(false)
  branch String
  containerPort Int
  healthPath String
  status DeploymentStatus @default(QUEUED)
  kind String @default("DEPLOY")
  sourceDeploymentId String?
  environmentSnapshot String?
  cleanupPending Boolean @default(false)
  cleanupError String?
  workspacePath String?
  commitSha String?
  imageTag String?
  containerId String?
  hostPort Int?
  errorMessage String?
  queuedAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events DeploymentEvent[]
  @@index([projectId, createdAt])
  @@index([status])
}
model DeploymentEvent {
  id Int @id @default(autoincrement())
  deploymentId String
  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  type String
  level String @default("info")
  message String
  createdAt DateTime @default(now())
  @@index([deploymentId, id])
}

model ProjectVariable {
 id String @id @default(cuid())
 projectId String
 project Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
 name String
 encryptedValue String
 updatedAt DateTime @updatedAt
 @@unique([projectId,name])
}
model HealthCheck {
 id String @id @default(cuid())
 projectId String
 project Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
 deploymentId String
 status RuntimeStatus
 httpStatus Int?
 responseTimeMs Int?
 message String?
 checkedAt DateTime @default(now())
 @@index([projectId,checkedAt])
}
